<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Drop-in replacement for TestECManager$TestExpandingCapacity (oemec module) that
          answers real requests instead of canned ones — see README.md for what this does
          and does NOT provide (no model files ship with this module).
          Point OemEC at this instead of TestECService via the
          expand_capacity_service_package_name/_cls/_action string resources.
        -->
        <service
            android:name="com.ct.oemec.translatetflite.TranslateTfliteService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.newcalllib.datachannel.V1_0.ECService" />
            </intent-filter>
        </service>
    </application>
</manifest>
