<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application>
        <!--
          Real, pragmatic Translate EC provider: android.speech.SpeechRecognizer for ASR
          (owns the microphone directly and natively while listening — the mini-app's own
          getUserMedia capture is NOT used by this provider, see README.md) + ML Kit
          Translate for MT. Point OemEC's expand_capacity_service_cls string resource at
          this class instead of TestECService/TranslateTfliteService to use it.
        -->
        <service
            android:name="com.ct.oemec.speechkittranslate.SpeechKitTranslateService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.newcalllib.datachannel.V1_0.ECService" />
            </intent-filter>
        </service>
    </application>
</manifest>
